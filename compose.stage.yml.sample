# Stage override. Requires Docker Compose v2.24+ (for the `!override` merge
# tag). There is no stage server yet; this is the template for one.
#
# On the server, copy this file to compose.stage.yml and enable it in the
# server's .env:
#
#   COMPOSE_FILE="compose.yml;compose.stage.yml"
#   COMPOSE_PATH_SEPARATOR=";"
#
# Set HOST_NAME to the stage domain (for example stage.mody.cloud). TLS is
# terminated upstream, so Nginx listens on plain HTTP and mounts no
# certificate. Mailpit never runs here either (see compose.prod.yml.sample).
services:
  nginx:
    # `!override` fully replaces the base list instead of appending to it —
    # without it, compose.yml's 80/443 mappings would remain published
    # alongside this one (ports merge by {ip, target, published, protocol},
    # not by service).
    ports: !override
      - "${NGINX_HTTP_PORT:-80}:80"
    volumes: !override
      - ./app:/var/www/html
      - ./config/nginx/app.conf.template:/etc/nginx/templates/app.conf.template:ro
    environment:
      NGINX_APP_LISTEN: "80"
      NGINX_APP_SERVER_NAME: "${HOST_NAME:-stage.mody.cloud} *.${HOST_NAME:-stage.mody.cloud}"
      NGINX_APP_SSL_DIRECTIVES: ""
      # See compose.prod.yml.sample: the base HTTPS redirect would loop here.
      NGINX_HTTP_REDIRECT_SERVER: ""

  wordpress:
    # Don't publish Xdebug's port to the host on stage.
    ports: !reset []

  database:
    # Don't publish MariaDB to the host on stage.
    ports: !reset []

  mailpit:
    # Never start Mailpit on stage.
    profiles: ["never-start"]
