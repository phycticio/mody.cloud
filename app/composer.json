{
    "name": "mody_cloud/wp",
    "version": "0.0.1",
    "description": "Mody Cloud: sovereign WordPress site generator",
    "authors": [
        {
            "name": "Mody Cloud"
        }
    ],
    "repositories": {
        "satispress": {
            "type": "composer",
            "url": "https://plugins.mody.cloud/satispress/",
            "only": [
                "mody/*"
            ]
        },
        "wpackagist": {
            "type": "composer",
            "url": "https://wpackagist.org",
            "only": [
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    },
    "require": {
        "composer/installers": "^2.3",
        "wpackagist-plugin/wordfence": "9.0.2",
        "wpackagist-plugin/ai": "1.5.0",
        "wpackagist-plugin/ai-provider-for-ollama": "1.4.0",
        "wpackagist-plugin/mcp-adapter": "0.7.1",
        "wpackagist-plugin/spectra-blocks": "1.0.13"
    },
    "require-dev": {
        "wpackagist-plugin/query-monitor": "3.20.2"
    },
    "extra": {
        "installer-paths": {
            "web/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
