{
    "family": "post",
    "label": "Posts",
    "top": "spectra/post",
    "blocks": [
        "spectra/post",
        "spectra/post-template",
        "spectra/post-no-results",
        "core/post-featured-image",
        "core/post-title",
        "core/post-date",
        "core/post-excerpt",
        "core/read-more"
    ],
    "when": "the site's own latest posts as a grid of cards (a blog or news section, recent articles)",
    "keywords": [
        "blog",
        "latest posts",
        "recent posts",
        "latest articles",
        "latest news",
        "post grid",
        "ultimas entradas",
        "entradas recientes",
        "ultimas noticias",
        "ultimos articulos",
        "derniers articles",
        "articles recents",
        "dernieres actualites",
        "neuesten beitrage",
        "neuesten beitraege",
        "neueste beitrage",
        "neueste beitraege",
        "ultimi articoli",
        "articoli recenti",
        "ultime notizie",
        "ultimos artigos",
        "artigos recentes",
        "ultimas publicacoes",
        "laatste berichten",
        "recente berichten",
        "laatste nieuws",
        "darreres entrades",
        "ultimes entrades",
        "darreres noticies"
    ],
    "rules": "The site's own posts, newest first; never write a post's text. spectra/post holds one spectra/post-template, then one spectra/post-no-results (shown with no posts). The template holds ONE post's blocks, repeated per post, valid only there: post-featured-image, post-title (level 3, isLink true), post-date (copy it exactly), post-excerpt, read-more (\"content\" in the page's language). \"query\":{\"perPage\":N} is how many (default 6). \"columns\" 2 to 4 (default 3); keep the example's \"style\". \"layoutType\":\"carousel\" makes slides (\"postsToShow\" = how many). No pagination, colors or containers.",
    "example": "<!-- wp:spectra/post {\"variationSelected\":true,\"query\":{\"perPage\":3},\"style\":{\"@tablet\":{\"columns\":2},\"@mobile\":{\"columns\":1}}} -->\n<!-- wp:spectra/post-template {\"variationSelected\":true} -->\n<!-- wp:post-featured-image {\"isLink\":true,\"aspectRatio\":\"16/9\"} /-->\n\n<!-- wp:post-title {\"level\":3,\"isLink\":true,\"fontSize\":\"large\"} /-->\n\n<!-- wp:post-date {\"metadata\":{\"bindings\":{\"datetime\":{\"source\":\"core/post-data\",\"args\":{\"field\":\"date\"}}}}} /-->\n\n<!-- wp:post-excerpt {\"excerptLength\":20} /-->\n\n<!-- wp:read-more {\"content\":\"Read more\"} /-->\n<!-- /wp:spectra/post-template -->\n\n<!-- wp:spectra/post-no-results -->\n<!-- wp:paragraph {\"style\":{\"typography\":{\"textAlign\":\"center\"}}} -->\n<p class=\"has-text-align-center\">No posts yet. Come back soon.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:spectra/post-no-results -->\n<!-- /wp:spectra/post -->"
}
