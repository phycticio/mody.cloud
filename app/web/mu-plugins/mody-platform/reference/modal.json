{
    "family": "modal",
    "label": "Modal",
    "top": "spectra/modal",
    "blocks": [
        "spectra/modal",
        "spectra/modal-child-trigger",
        "spectra/modal-child-button",
        "spectra/modal-child-icon",
        "spectra/modal-child-content",
        "spectra/modal-popup",
        "spectra/modal-child-popup-close-icon",
        "spectra/modal-popup-content"
    ],
    "when": "secondary details that open in a popup when the reader clicks (terms, opening hours, fine print), never the page's main content",
    "keywords": [
        "modal",
        "modals",
        "popup",
        "popups",
        "pop up",
        "pop ups",
        "dialog box",
        "ventana emergente",
        "ventanas emergentes",
        "ventana modal",
        "cuadro de dialogo",
        "fenetre modale",
        "fenetre contextuelle",
        "boite de dialogue",
        "modales fenster",
        "dialogfenster",
        "finestra modale",
        "finestra di dialogo",
        "finestra a comparsa",
        "janela modal",
        "caixa de dialogo",
        "popupvenster",
        "modaal venster",
        "dialoogvenster",
        "finestra emergent",
        "finestra modal",
        "quadre de dialeg"
    ],
    "rules": "Secondary content only: a popup stays hidden until the reader clicks (terms, opening hours, fine print), so never put the page's main message in it. The trigger holds modal-child-button, modal-child-icon, modal-child-content, in that order, self-closing. \"modalTrigger\" on spectra/modal names the one shown: \"button\" (default, omit) or \"text\"; give only that child its \"text\". The popup holds modal-child-popup-close-icon, then modal-popup-content with the blocks, \"backgroundColor\":\"base\", \"textColor\":\"contrast\". \"overlayClick\":true closes on an outside click. Never write modalId or isVisible.",
    "example": "<!-- wp:spectra/modal {\"overlayClick\":true} -->\n<!-- wp:spectra/modal-child-trigger -->\n<!-- wp:spectra/modal-child-button {\"text\":\"See opening hours\"} /-->\n\n<!-- wp:spectra/modal-child-icon /-->\n\n<!-- wp:spectra/modal-child-content /-->\n<!-- /wp:spectra/modal-child-trigger -->\n\n<!-- wp:spectra/modal-popup -->\n<!-- wp:spectra/modal-child-popup-close-icon /-->\n\n<!-- wp:spectra/modal-popup-content {\"textColor\":\"contrast\",\"backgroundColor\":\"base\"} -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Opening hours</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Monday to Friday, 9 am to 6 pm. Closed on Sundays.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:spectra/modal-popup-content -->\n<!-- /wp:spectra/modal-popup -->\n<!-- /wp:spectra/modal -->\n\n<!-- wp:spectra/modal {\"modalTrigger\":\"text\"} -->\n<!-- wp:spectra/modal-child-trigger -->\n<!-- wp:spectra/modal-child-button /-->\n\n<!-- wp:spectra/modal-child-icon /-->\n\n<!-- wp:spectra/modal-child-content {\"text\":\"Read the delivery terms\",\"textColor\":\"primary\"} /-->\n<!-- /wp:spectra/modal-child-trigger -->\n\n<!-- wp:spectra/modal-popup -->\n<!-- wp:spectra/modal-child-popup-close-icon /-->\n\n<!-- wp:spectra/modal-popup-content {\"textColor\":\"contrast\",\"backgroundColor\":\"base\"} -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Delivery terms</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We deliver within the city on weekdays. Orders placed before noon go out the same day.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:spectra/modal-popup-content -->\n<!-- /wp:spectra/modal-popup -->\n<!-- /wp:spectra/modal -->"
}
