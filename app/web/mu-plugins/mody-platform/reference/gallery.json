    "family": "gallery",
    "label": "Gallery",
    "top": "core/gallery",
    "blocks": [
        "core/gallery"
    ],
    "when": "several pictures shown together in a grid (the work, the products, the place, the team)",
    "media": true,
    "keywords": [
