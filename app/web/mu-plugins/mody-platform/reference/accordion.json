{
    "family": "accordion",
    "label": "Accordion",
    "top": "spectra/accordion",
    "blocks": [
        "spectra/accordion",
        "spectra/accordion-child-item",
        "spectra/accordion-child-header",
        "spectra/accordion-child-header-content",
        "spectra/accordion-child-header-icon",
        "spectra/accordion-child-details"
    ],
    "when": "questions and answers (an FAQ)",
    "keywords": [
        "faq",
        "faqs",
        "question",
        "questions",
        "answers",
        "accordion",
        "preguntas",
        "pregunta",
        "respuestas",
        "acordeon",
        "fragen",
        "frage",
        "antworten",
        "domande",
        "domanda",
        "risposte",
        "fisarmonica",
        "reponses",
        "perguntas",
        "pergunta",
        "respostas",
        "vragen",
        "vraag",
        "antwoorden",
        "preguntes",
        "respostes"
    ],
    "rules": "One accordion-child-item per question. The question is the \"text\" of accordion-child-header-content; the answer is paragraphs or a list inside accordion-child-details. Only the first item has \"openByDefault\":true.",
    "example": "<!-- wp:spectra/accordion -->\n<!-- wp:spectra/accordion-child-item {\"openByDefault\":true} -->\n<!-- wp:spectra/accordion-child-header -->\n<!-- wp:spectra/accordion-child-header-content {\"text\":\"Do I need an appointment?\"} /-->\n\n<!-- wp:spectra/accordion-child-header-icon /-->\n<!-- /wp:spectra/accordion-child-header -->\n\n<!-- wp:spectra/accordion-child-details -->\n<!-- wp:paragraph -->\n<p>No. Bring your bike before 10 am and it is usually ready the same day.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:spectra/accordion-child-details -->\n<!-- /wp:spectra/accordion-child-item -->\n\n<!-- wp:spectra/accordion-child-item -->\n<!-- wp:spectra/accordion-child-header -->\n<!-- wp:spectra/accordion-child-header-content {\"text\":\"Do you repair e-bikes?\"} /-->\n\n<!-- wp:spectra/accordion-child-header-icon /-->\n<!-- /wp:spectra/accordion-child-header -->\n\n<!-- wp:spectra/accordion-child-details -->\n<!-- wp:paragraph -->\n<p>Yes, including batteries and motors.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:spectra/accordion-child-details -->\n<!-- /wp:spectra/accordion-child-item -->\n<!-- /wp:spectra/accordion -->"
}
