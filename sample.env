# Compose picks these two up automatically, so every "docker compose ..." in
# this repository loads the tracked local override (compose.local.yml) on top of
# the base stack. The override is what gives Nginx the wildcard server_name the
# subdomain network needs, so leave both set for local development. The value
# stays quoted because the bin/ scripts "source" this file in bash and would
# otherwise read ";" as a command separator.
COMPOSE_FILE="compose.yml;compose.local.yml"
COMPOSE_PATH_SEPARATOR=";"

# UID that www-data runs as inside the containers. Set it to your Mac user's
# UID (`id -u`, usually 501) when running Colima on macOS with sshfs mounts,
# so that www-data owns the files it writes. Linux defaults to 1000.
# See documentation/local-development.md#colima-on-macos.
# USER_ID=501

DB_NAME=mody_cloud
DB_USER=mody_cloud
DB_PASSWORD=mody_cloud
DB_ROOT_PASSWORD=mody_cloud_root
# Everything in this file reaches the PHP container (compose.yml uses env_file),
# including DB_ROOT_PASSWORD, SATISPRESS_KEY and SITE_ADMIN_PASSWD, which PHP
# never needs. On a server, keep this file's secrets to what the stack uses and
# take SITE_ADMIN_PASSWD out once the network is installed. Narrowing the list
# is planned: documentation/architecture.md#security-hardening.

WORDPRESS_ENVIRONMENT="local"
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_LOG=../logs/debug.log
WORDPRESS_DEBUG_DISPLAY=false
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_VERSION=7.0
WORDPRESS_IMAGE_VERSION="${WORDPRESS_VERSION}-fpm-alpine"
WORDPRESS_MEMORY_LIMIT="256M"

# Outgoing mail: the mody-mail MU plugin, the only way the app sends email.
# Every message leaves from this sender. In production it must be a sender
# verified in Brevo. Defaults: no-reply@<network domain>, "Mody Cloud".
MAIL_SENDER_EMAIL="no-reply@${HOST_NAME}"
MAIL_SENDER_NAME="Mody Cloud"

# Brevo's transactional API (production mail, decided 2026-11-09). With a key,
# every email goes through Brevo; without one, PHP's mail() hands it to Mailpit
# (locally), and in production every email fails. The key is a secret: set it
# only in the server's .env, never commit it.
BREVO_API_KEY=""

# WordPress keys and salts: they sign login cookies and nonces. app/wp-config.php
# still falls back to values that are committed to git, which anyone can read.
# Left empty, WordPress makes its own random ones the first time they are needed
# and keeps them in the database; and where these stay at the committed values,
# the platform's Security\Secrets replaces them the same way (a network option,
# mody_security_secrets). Either way the first request after the change logs
# everyone out once. To fix them in the environment instead, give each one its
# own long random value (`openssl rand -hex 32`); changing one logs everyone out.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=

# Site configuration
WORDPRESS_DISALLOW_FILE_EDIT=true
WORDPRESS_AUTOMATIC_UPDATER_DISABLED=true
WORDPRESS_DISALLOW_FILE_MODS=false
WORDPRESS_AUTO_UPDATE_CORE=false
WORDPRESS_POST_REVISIONS=50
WORDPRESS_CONCATENATE_SCRIPTS=true
WORDPRESS_FORCE_SSL_ADMIN=true
WORDPRESS_EMPTY_TRASH_DAYS=3
WORDPRESS_COMPRESS_CSS=true
WORDPRESS_COMPRESS_SCRIPTS=true
WORDPRESS_ENFORCE_GZIP=true
WORDPRESS_DISABLE_WP_CRON=false

# Multisite, subdomain install (M0-01). wp-config.php reads these three;
# compose.yml passes them into the container and defaults them to false.
# Bootstrap from scratch with them still false (single-site install plus
# `wp core multisite-convert`), then set true - see documentation/local-development.md.
WORDPRESS_ALLOW_MULTISITE=true
WORDPRESS_MULTISITE=true
WORDPRESS_SUBDOMAIN_INSTALL=true

SITE_TITLE="Mody Cloud"
SITE_ADMIN_USER="admin"
SITE_ADMIN_EMAIL="admin@mody.cloud"
SITE_ADMIN_PASSWD="password"
HOST_NAME="mody.cloud.local"
PROXY_NAME="mody.cloud"
MAIL_HOST="mail.mody.cloud.local"
# The wildcard is what makes the subdomain network work: ./bin/certs asks
# mkcert for one certificate covering every <subsite>.${HOST_NAME}.
APP_DOMAINS="${HOST_NAME} *.${HOST_NAME} ${MAIL_HOST}"

# Where the stack's own Nginx publishes itself on the host. These are a local
# detail only: they never appear in a site URL. Site host names are always
# reached on standard ports, so if something else on the machine already owns
# 443, move these and put that proxy in front of the stack - do not expose the
# port. WordPress strips only ":80" and ":443" from the request host, so a port
# in the host never matches wp_blogs.domain and every request would end on the
# "site not installed" signup redirect. See documentation/local-development.md.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# MariaDB (and Xdebug's 9003) are published on 127.0.0.1 only: compose.yml binds
# them to the loopback address, so another machine on the network cannot reach
# the development database. Production publishes neither (compose.prod.yml).
DB_HOST_PORT=3306

# Local TLS files generated by ./bin/certs for Docker Nginx.
NGINX_SSL_CERT_FILE=
NGINX_SSL_KEY_FILE=

CONTAINER_PREFIX="mody_cloud_"

# WP-CLI alias used by ./bin/wp (must match an alias in wp-cli.yml).
SITE_SLUG="mody"

SATISPRESS_KEY=placeholder
PLUGIN_REPO_HOST=plugins.mody.cloud

# Infomaniak AI Services for the WordPress AI Client (documentation/ai-engine.md).
# The token is read by core as INFOMANIAK_API_KEY. After editing .env, run
# `docker compose up -d wordpress` so the container picks the values up.
INFOMANIAK_API_KEY=some-token
INFOMANIAK_AI_BASE_URL="https://api.infomaniak.com/2/ai/<PRODUCT_ID>/openai/v1"
# Optional; the default is Qwen/Qwen3.8-27B-FP8.
# INFOMANIAK_AI_MODEL=Qwen/Qwen3.8-27B-FP8
# The model that writes and changes pages (default: the model above). The agent
# stays on the model above.
# INFOMANIAK_AI_WRITER_MODEL=Qwen/Qwen3.8-27B-FP8

# Mollie card payments (M1-01 part 3; Billing\Mollie). A `test_…` key for the
# sandbox, a `live_…` key for real money; without it, card payments stay off.
# After editing .env, run `docker compose up -d wordpress`, then
# `docker compose restart nginx` (it keeps the old container's address: 502).
# MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom domains (tickets/custom-domains.md): Nginx Proxy Manager's API, as the
# app container reaches it, and an NPM user that manages proxy hosts and
# certificates. Without them, domains are checked but get no certificate.
# NPM_API_URL=http://host.docker.internal:81/api
# NPM_API_EMAIL=
# NPM_API_PASSWORD=
# Where domains' proxy hosts forward when the NPM user cannot see HOST_NAME's own
# (default: host.docker.internal and NGINX_HTTP_PORT).
# NPM_FORWARD_HOST=
# NPM_FORWARD_PORT=
# Where members point their CNAME (default: sites.<HOST_NAME>).
# MODY_DOMAINS_TARGET=

