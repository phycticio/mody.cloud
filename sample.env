# Compose picks these two up automatically, so every "docker compose ..." in
# this repository loads the tracked local override (compose.local.yml) on top of
# the base stack. The override is what gives Nginx the wildcard server_name the
# subdomain network needs, so leave both set for local development. The value
# stays quoted because the bin/ scripts "source" this file in bash and would
# otherwise read ";" as a command separator.
COMPOSE_FILE="compose.yml;compose.local.yml"
COMPOSE_PATH_SEPARATOR=";"

DB_NAME=mody_cloud
DB_USER=mody_cloud
DB_PASSWORD=mody_cloud
DB_ROOT_PASSWORD=mody_cloud_root

WORDPRESS_ENVIRONMENT="local"
WORDPRESS_DEBUG=true
WORDPRESS_DEBUG_LOG=../logs/debug.log
WORDPRESS_DEBUG_DISPLAY=false
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_VERSION=7.0
WORDPRESS_IMAGE_VERSION="${WORDPRESS_VERSION}-fpm-alpine"
WORDPRESS_MEMORY_LIMIT="256M"

WORDPRESS_SMTP_ON=true
WORDPRESS_SMTP_MAILER="smtp"
WORDPRESS_SMTP_HOST="mailpit"
WORDPRESS_SMTP_PORT=1025

# Site configuration
WORDPRESS_DISALLOW_FILE_EDIT=true
WORDPRESS_AUTOMATIC_UPDATER_DISABLED=true
WORDPRESS_DISALLOW_FILE_MODS=false
WORDPRESS_AUTO_UPDATE_CORE=false
WORDPRESS_POST_REVISIONS=3
WORDPRESS_CONCATENATE_SCRIPTS=true
WORDPRESS_FORCE_SSL_ADMIN=true
WORDPRESS_EMPTY_TRASH_DAYS=3
WORDPRESS_COMPRESS_CSS=true
WORDPRESS_COMPRESS_SCRIPTS=true
WORDPRESS_ENFORCE_GZIP=true
WORDPRESS_DISABLE_WP_CRON=false

# Multisite, subdomain install (M0-01). wp-config.php reads these three;
# compose.yml passes them into the container and defaults them to false.
# Bootstrap from scratch with them still false (single-site install plus
# `wp core multisite-convert`), then set true - see documentation/local-development.md.
WORDPRESS_ALLOW_MULTISITE=true
WORDPRESS_MULTISITE=true
WORDPRESS_SUBDOMAIN_INSTALL=true

SITE_TITLE="Mody Cloud"
SITE_ADMIN_USER="admin"
SITE_ADMIN_EMAIL="admin@mody.cloud"
SITE_ADMIN_PASSWD="password"
HOST_NAME="mody.cloud.local"
PROXY_NAME="mody.cloud"
MAIL_HOST="mail.mody.cloud.local"
# The wildcard is what makes the subdomain network work: ./bin/certs asks
# mkcert for one certificate covering every <subsite>.${HOST_NAME}.
APP_DOMAINS="${HOST_NAME} *.${HOST_NAME} ${MAIL_HOST}"

# Where the stack's own Nginx publishes itself on the host. These are a local
# detail only: they never appear in a site URL. Site host names are always
# reached on standard ports, so if something else on the machine already owns
# 443, move these and put that proxy in front of the stack - do not expose the
# port. WordPress strips only ":80" and ":443" from the request host, so a port
# in the host never matches wp_blogs.domain and every request would end on the
# "site not installed" signup redirect. See documentation/local-development.md.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
DB_HOST_PORT=3306

# Local TLS files generated by ./bin/certs for Docker Nginx.
NGINX_SSL_CERT_FILE=
NGINX_SSL_KEY_FILE=

CONTAINER_PREFIX="mody_cloud_"

# WP-CLI alias used by ./bin/wp (must match an alias in wp-cli.yml).
SITE_SLUG="mody"

SATISPRESS_KEY=placeholder
PLUGIN_REPO_HOST=plugins.mody.cloud
