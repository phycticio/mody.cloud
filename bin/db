#!/usr/bin/env bash

ROOT_DIR=$(pwd)
COMMAND="${1:-import}"

START_TIME_SECONDS=$(date +%s)
START_TIME_HUMAN=$(date "+%Y-%m-%d %H:%M:%S")

./bin/log "INFO" "Starting DB command at ${START_TIME_HUMAN}"

DB_CONFIG="${ROOT_DIR}/config/bin/db.config"
if [ ! -f "$DB_CONFIG" ]; then
    ./bin/log "ERROR" "DB config file not found: $DB_CONFIG"
    exit 1
fi
# shellcheck disable=SC1090
source "${DB_CONFIG}"

ENV_FILE="${ROOT_DIR}/.env"
if [ ! -f "${ENV_FILE}" ]; then
    ./bin/log "ERROR" "Environment file ${ENV_FILE} not found"
    exit 1
fi

source "${ENV_FILE}"
DB_NAME="${DB_NAME:-mody_cloud}"
FILE_NAME="${DB_NAME}.sql"
CONTAINER_PATH="/var/www/html/dumps"
LOCAL_PATH="${ROOT_DIR}/app/dumps"
LOCAL_FILE="${LOCAL_PATH}/${FILE_NAME}"

if [ ! -f "${LOCAL_FILE}" ]; then
    ./bin/log "ERROR" "Database dump not found: ${LOCAL_FILE}"
    exit 1
fi

if [[ "$COMMAND" == "pull" || "$COMMAND" == "download" ]]; then
    ./bin/log "ERROR" "Remote pull/download is not used for this single-site project; import the local dump in ${LOCAL_FILE}."
    exit 1
fi

./bin/log "INFO" "Importing database ${FILE_NAME} into the local WordPress container..."
if bash ${ROOT_DIR}/bin/wp db import "${CONTAINER_PATH}/${FILE_NAME}"; then
    ./bin/log "SUCCESS" "Database ${FILE_NAME} imported successfully"
else
    ./bin/log "ERROR" "Database import failed! Check if mysql-client is installed in the container."
    exit 1
fi

OLD_DOMAIN="${PROXY_NAME:-mody.cloud}"
NEW_DOMAIN="${HOST_NAME:-mody.cloud.local}"

./bin/log "INFO" "Replacing production domain ${OLD_DOMAIN} with local domain ${NEW_DOMAIN}..."
if bash ${ROOT_DIR}/bin/wp search-replace "https://${OLD_DOMAIN}" "https://${NEW_DOMAIN}" --all-tables --skip-plugins --skip-themes; then
    ./bin/log "SUCCESS" "Domain replaced from ${OLD_DOMAIN} to ${NEW_DOMAIN}"
else
    ./bin/log "ERROR" "Failed to replace ${OLD_DOMAIN} with ${NEW_DOMAIN}"
    exit 1
fi

if bash ${ROOT_DIR}/bin/wp search-replace "http://${OLD_DOMAIN}" "http://${NEW_DOMAIN}" --all-tables --skip-plugins --skip-themes; then
    ./bin/log "SUCCESS" "HTTP domain replaced from ${OLD_DOMAIN} to ${NEW_DOMAIN}"
else
    ./bin/log "ERROR" "Failed to replace http://${OLD_DOMAIN} with http://${NEW_DOMAIN}"
    exit 1
fi

END_TIME_SECONDS=$(date +%s)
END_TIME_HUMAN=$(date "+%Y-%m-%d %H:%M:%S")
ELAPSED_TOTAL=$((END_TIME_SECONDS - START_TIME_SECONDS))
ELAPSED_MIN=$((ELAPSED_TOTAL / 60))
ELAPSED_SEC=$((ELAPSED_TOTAL % 60))

echo ""
./bin/log "INFO" "Ending DB command at ${END_TIME_HUMAN}"
./bin/log "INFO" "Elapsed time: ${ELAPSED_MIN}:$(printf "%02d" $ELAPSED_SEC)"
exit 0
