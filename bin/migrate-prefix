#!/usr/bin/env bash
# Rewrites a mysqldump SQL file, replacing the source table prefix with wp_<SITE_ID>_.
# The source prefix defaults to wp_; the legacy four-argument form can override it.
# Usage: ./bin/migrate-prefix <input.sql> <site-id> [output.sql]

set -euo pipefail

ROOT_DIR=$(pwd)
ENV_FILE="${ROOT_DIR}/.env"
./bin/log "INFO" "Checking .env file exists in ${ENV_FILE}"
if [ ! -f "${ENV_FILE}" ]; then
  ./bin/log "ERROR" "No .env file found"
  exit 1;
fi
source "${ENV_FILE}";

if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
  SITE_ID="${1:-}"
  OLD_PREFIX="${2:-}"
  INPUT_FILE="${3:-}"
  OUTPUT_FILE="${4:-}"
else
  INPUT_FILE="${1:-}"
  SITE_ID="${2:-}"
  OUTPUT_FILE="${3:-}"
  OLD_PREFIX="wp_"
fi

if [ -z "$INPUT_FILE" ] || [ -z "$SITE_ID" ] || [ -z "$OLD_PREFIX" ]; then
  ./bin/log "ERROR" "Usage: ./bin/migrate-prefix <input.sql> <site-id> [output.sql]"
  ./bin/log "ERROR" "  Example: ./bin/migrate-prefix dump.sql 3 dump-site3.sql"
  exit 1
fi

if [ ! -f "$INPUT_FILE" ]; then
  ./bin/log "ERROR" "Input file not found: $INPUT_FILE"
  exit 1
fi

if ! [[ "$SITE_ID" =~ ^[0-9]+$ ]]; then
  ./bin/log "ERROR" "Site ID must be a positive integer, got: $SITE_ID"
  exit 1
fi

NEW_PREFIX="${WORDPRESS_TABLE_PREFIX}${SITE_ID}_"

if [ -z "$OUTPUT_FILE" ]; then
  BASENAME="${INPUT_FILE%.sql}"
  OUTPUT_FILE="${BASENAME}-site${SITE_ID}.sql"
fi

./bin/log "INFO" "Rewriting prefixes: ${OLD_PREFIX} -> ${NEW_PREFIX}"
./bin/log "INFO" "Input:  $INPUT_FILE"
./bin/log "INFO" "Output: $OUTPUT_FILE"

# LC_ALL=C forces byte-mode so sed doesn't choke on non-UTF-8 sequences
# (common in mysqldumps with latin-1 stored content). Works on both
# macOS (BSD sed) and Linux (GNU sed).
LC_ALL=C sed "s/\`${OLD_PREFIX}/\`${NEW_PREFIX}/g" "$INPUT_FILE" > "$OUTPUT_FILE"

LINE_COUNT=$(wc -l < "$OUTPUT_FILE" | xargs)
./bin/log "SUCCESS" "Done. Output has ${LINE_COUNT} lines: $OUTPUT_FILE"
