#!/usr/bin/env bash

# Build the project.
#
#   1. JS and CSS with @wordpress/scripts (pnpm build): src/ -> app/dist.
#   2. PHP dependencies with Composer: app/vendor and app/web/plugins.
#
# Usage:
#   ./bin/build            # local: Composer with dev requirements (Query Monitor)
#   ./bin/build prod       # prod and stage: no dev requirements, frozen lockfile
#   ./bin/build stage
#
# Outside GitHub Actions, Composer runs in the app container, so the local
# stack must be running.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

ENV_MODE="${1:-local}"
case "$ENV_MODE" in
  local) COMPOSER_FLAGS=(--optimize-autoloader) ;;
  stage|prod) COMPOSER_FLAGS=(--no-dev --optimize-autoloader) ;;
  *)
    ./bin/log "ERROR" "Unknown build mode: ${ENV_MODE} (expected local, stage or prod)"
    exit 1
    ;;
esac
./bin/log "INFO" "Building in ${ENV_MODE} mode..."

BUILD_CONFIG="${ROOT_DIR}/config/bin/build.config"
if [ ! -f "$BUILD_CONFIG" ]; then
  ./bin/log "ERROR" "Build config file not found: $BUILD_CONFIG"
  exit 1
fi
# shellcheck disable=SC1090
source "${BUILD_CONFIG}"

if ! command -v pnpm >/dev/null 2>&1; then
  ./bin/log "ERROR" "pnpm is not installed (package.json pins the version in packageManager)."
  exit 1
fi

# A release build must use exactly what pnpm-lock.yaml pins.
if [ "$ENV_MODE" != "local" ] || [ "${GITHUB_ACTIONS:-}" = "true" ]; then
  pnpm install --frozen-lockfile
else
  pnpm install
fi
pnpm build

./bin/log "INFO" "Installing Composer dependencies (${COMPOSER_FLAGS[*]})..."
if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
  composer install --working-dir="./app" "${COMPOSER_FLAGS[@]}"
else
  ./bin/composer install "${COMPOSER_FLAGS[@]}"
fi

./bin/log "SUCCESS" "Build complete."
