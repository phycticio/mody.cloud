#!/usr/bin/env bash
ROOT_DIR=$(pwd)
YML_FILE="${ROOT_DIR}/wp-cli.yml"
ENV_FILE="${ROOT_DIR}/.env"

if [ ! -f $ENV_FILE ]; then
  ./bin/log "ERROR" "No .env file found"
  exit 1;
fi

source "${ENV_FILE}"
ALIAS="${SITE_SLUG}"

if [ ! -f "$YML_FILE" ]; then
    ./bin/log "ERROR" "wp-cli.yml not found in $(pwd)"
    exit 1
fi

CONTAINER_NAME=$(grep -A 1 "@$ALIAS:" "$YML_FILE" | grep 'ssh:' | sed -E 's/.*@([^ ]+).*/\1/')

if [ -z "$CONTAINER_NAME" ]; then
    ./bin/log "ERROR" "Alias @$ALIAS not found in $YML_FILE"
    exit 1
fi

if [ -t 0 ]; then
    TTY_FLAG="-it"
else
    TTY_FLAG="-i"
fi

DOCKER_ENV_ARGS=()
if [ -n "${TAMARIND_MIGRATION_IDENTITY_KEY:-}" ]; then
    DOCKER_ENV_ARGS+=(-e TAMARIND_MIGRATION_IDENTITY_KEY)
fi

if [ -n "${TAMARIND_MIGRATION_APPROVAL_KEY:-}" ]; then
    DOCKER_ENV_ARGS+=(-e TAMARIND_MIGRATION_APPROVAL_KEY)
fi

if [ -n "${TAMARIND_MIGRATION_DATA_KEY:-}" ]; then
    DOCKER_ENV_ARGS+=(-e TAMARIND_MIGRATION_DATA_KEY)
fi

# Per-site addressing for the subdomain Multisite network.
#
# WP-CLI needs --url=<host> to pick a subsite, so "--site=<slug>" builds it from
# HOST_NAME instead of making every caller repeat it:
#
#   ./bin/wp --site=alpha plugin list      ->  --url=alpha.mody.local
#   ./bin/wp --site=main option get home   ->  --url=mody.local
#
# No port is ever added. Site hosts are reached on standard ports, through the
# proxy in front of the stack where there is one, and WordPress would not match
# a host carrying a port against wp_blogs.domain anyway (app/wp-config.php).
#
# A literal --url=... is still passed through untouched, and commands with no
# site argument run against the network's main site.
WP_ARGS=()
SUBSITE=""
for arg in "$@"; do
    case "$arg" in
        --site=*) SUBSITE="${arg#--site=}" ;;
        *) WP_ARGS+=("$arg") ;;
    esac
done

if [ -n "$SUBSITE" ]; then
    if [ -z "${HOST_NAME:-}" ]; then
        ./bin/log "ERROR" "--site=$SUBSITE needs HOST_NAME in .env"
        exit 1
    fi

    if [ "$SUBSITE" = "main" ]; then
        SITE_HOST="${HOST_NAME}"
    else
        SITE_HOST="${SUBSITE}.${HOST_NAME}"
    fi

    WP_ARGS=("--url=${SITE_HOST}" "${WP_ARGS[@]}")
fi

./bin/log "INFO" "wp ${WP_ARGS[*]} in container $CONTAINER_NAME" >&2
docker exec $TTY_FLAG "${DOCKER_ENV_ARGS[@]}" -u www-data "$CONTAINER_NAME" wp "${WP_ARGS[@]}"
