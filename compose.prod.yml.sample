# Production override for mody.cloud. Requires Docker Compose v2.24+ (for the
# `!override`/`!reset` merge tags).
#
# On the server, copy this file to compose.prod.yml and enable it in the
# server's .env:
#
#   COMPOSE_FILE="compose.yml;compose.prod.yml"
#   COMPOSE_PATH_SEPARATOR=";"
#
# compose.prod.yml is server-owned, like .env: ./bin/deploy ships this sample
# but never sends or deletes compose.prod.yml itself.
#
# TLS ends at the reverse proxy in front of the stack (Nginx Proxy Manager on
# the production host), so Nginx listens on plain HTTP only and mounts no
# certificate. Mailpit never runs in production: its service is disabled with
# the never-start profile, and Nginx does not load mailpit.conf.template
# (whose proxy_pass to mailpit:8025 would stop Nginx from starting without it).
#
# See documentation/architecture.md#production.
services:
  nginx:
    # `!override` fully replaces the base ports list instead of appending to
    # it — without it, compose.yml's 80/443 mappings would remain published
    # alongside this one (ports merge by {ip, target, published, protocol}).
    ports: !override
      - "${NGINX_HTTP_PORT:-8004}:80"
    # Only the app server block: no Mailpit template and no certificate files.
    volumes: !override
      - ./app:/var/www/html
      - ./config/nginx/app.conf.template:/etc/nginx/templates/app.conf.template:ro
    environment:
      NGINX_APP_LISTEN: "80"
      # Subdomain Multisite: the main site and every member subsite.
      NGINX_APP_SERVER_NAME: "${HOST_NAME:-mody.cloud} *.${HOST_NAME:-mody.cloud}"
      NGINX_APP_SSL_DIRECTIVES: ""
      # The base file adds a port-80 server that redirects to HTTPS. Here the
      # app itself listens on 80 behind a TLS-terminating proxy, so that
      # redirect would answer first and loop. Drop it.
      NGINX_HTTP_REDIRECT_SERVER: ""

  wordpress:
    # Don't publish Xdebug's port to the host in production.
    ports: !reset []

  database:
    # Don't publish MariaDB to the host in production.
    ports: !reset []

  mailpit:
    # Never start Mailpit in production. No profile named never-start is ever
    # enabled, so `docker compose up` skips this service.
    profiles: ["never-start"]
