# Production override for mody.cloud. Requires Docker Compose v2.24+ (for the
# `!override`/`!reset` merge tags).
#
# On the server, copy this file to compose.prod.yml and enable it in the
# server's .env:
#
#   COMPOSE_FILE="compose.yml;compose.prod.yml"
#   COMPOSE_PATH_SEPARATOR=";"
#
# compose.prod.yml is server-owned, like .env: ./bin/deploy ships this sample
# but never sends or deletes compose.prod.yml itself.
#
# TLS for visitors ends at the reverse proxy in front of the stack (Nginx Proxy
# Manager on the production host), which forwards plain HTTP to the published
# port. Nginx also listens on 443 inside the Docker network only, with the
# mkcert certificate from config/ssl: WordPress calls its own https:// URL for
# WP-Cron and Site Health, the network alias ${HOST_NAME} points those calls at
# this container, and without the listener they are refused. 443 is never
# published.
#
# Mailpit never runs in production: its service is disabled with the
# never-start profile, and Nginx does not load mailpit.conf.template (whose
# proxy_pass to mailpit:8025 would stop Nginx from starting without it).
#
# See documentation/architecture.md#production.
services:
  nginx:
    # `!override` fully replaces the base ports list instead of appending to
    # it — without it, compose.yml's 80/443 mappings would remain published
    # alongside this one (ports merge by {ip, target, published, protocol}).
    ports: !override
      - "${NGINX_HTTP_PORT:-8004}:80"
    # Only the app server block (no Mailpit template), plus the certificate
    # for the internal-only 443 listener.
    volumes: !override
      - ./app:/var/www/html
      - ./config/nginx/app.conf.template:/etc/nginx/templates/app.conf.template:ro
      - ${NGINX_SSL_CERT_FILE:-./config/ssl/local-cert.pem}:/etc/nginx/ssl/cert.pem:ro
      - ${NGINX_SSL_KEY_FILE:-./config/ssl/local-key.pem}:/etc/nginx/ssl/key.pem:ro
    environment:
      NGINX_APP_LISTEN: "80"
      # Subdomain Multisite: the main site and every member subsite.
      NGINX_APP_SERVER_NAME: "${HOST_NAME:-mody.cloud} *.${HOST_NAME:-mody.cloud}"
      # Internal-only HTTPS for WordPress's loopback requests (see above).
      NGINX_APP_SSL_DIRECTIVES: |
        listen 443 ssl;
        ssl_certificate /etc/nginx/ssl/cert.pem;
        ssl_certificate_key /etc/nginx/ssl/key.pem;
      # The base file adds a port-80 server that redirects to HTTPS. Here the
      # app itself listens on 80 behind a TLS-terminating proxy, so that
      # redirect would answer first and loop. Drop it.
      NGINX_HTTP_REDIRECT_SERVER: ""

  wordpress:
    # Don't publish Xdebug's port to the host in production.
    ports: !reset []
    # The daily billing run (M1-01 part 3, M1-02): payments still waiting,
    # reminders, charges and retries, plans that end, the day-53 warning and
    # the day-60 deletion. Started by the Ofelia scheduler on the host, which
    # reads these labels (`ofelia daemon --docker`); `job-exec` runs it inside
    # this container. Safe to run twice (a lock, and no period is charged
    # twice). `!override` drops the stale labels of compose.yml (the previous
    # project's newsletter job). The schedule has seconds first: 06:00 every
    # day, in the container's time zone (UTC).
    labels: !override
      ofelia.enabled: "true"
      ofelia.job-exec.mody-billing.schedule: "${OFELIA_BILLING_SCHEDULE:-0 0 6 * * *}"
      ofelia.job-exec.mody-billing.command: "wp --path=/var/www/html/wp --url=https://${HOST_NAME:-mody.cloud} mody-billing run"
      ofelia.job-exec.mody-billing.user: "www-data"
      ofelia.job-exec.mody-billing.no-overlap: "true"
    # Production mail (Brevo's API) needs nothing here: the mody-mail MU
    # plugin reads BREVO_API_KEY, MAIL_SENDER_EMAIL and MAIL_SENDER_NAME from
    # the server's .env, which compose.yml passes in with env_file.

  database:
    # Don't publish MariaDB to the host in production.
    ports: !reset []

  # Backups (tickets/backups.md): an idle container with restic and the
  # MariaDB client; the host's Ofelia runs mody-backup in it
  # (config/backup/mody-backup.sh). Every 6 hours the database is dumped and
  # sent off site; every night the dump, the uploads, this server's .env and
  # compose.prod.yml, and Nginx Proxy Manager's data; every Sunday old
  # snapshots are pruned and part of the data checked. Off site is an
  # encrypted restic repository at Infomaniak Swiss Backup: RESTIC_* and the
  # OS_* (Swift) credentials in .env. The dumps also stay on the laptop's
  # internal disk (BACKUP_LOCAL_DIR), apart from the sites' disk.
  # Ofelia reads labels only when it starts: `docker restart ofelia` after
  # adding or changing them. Schedules have seconds first, in UTC.
  backup:
    build:
      context: ./config/backup
    image: ${CONTAINER_PREFIX:-wp_}backup:1
    container_name: ${CONTAINER_PREFIX:-wp_}backup
    hostname: mody-backup
    restart: unless-stopped
    depends_on:
      - database
    environment:
      BACKUP_HOST: "${HOST_NAME:-mody.cloud}"
      BACKUP_DB_HOST: database
      BACKUP_DB_NAME: "${DB_NAME}"
      BACKUP_DB_USER: "${DB_USER}"
      BACKUP_DB_PASSWORD: "${DB_PASSWORD}"
      BACKUP_KEEP_LOCAL_DUMPS: "${BACKUP_KEEP_LOCAL_DUMPS:-12}"
      BACKUP_PING_URL: "${BACKUP_PING_URL:-}"
      RESTIC_REPOSITORY: "${RESTIC_REPOSITORY:-}"
      RESTIC_PASSWORD: "${RESTIC_PASSWORD:-}"
      OS_AUTH_URL: "${OS_AUTH_URL:-}"
      OS_REGION_NAME: "${OS_REGION_NAME:-}"
      OS_PROJECT_NAME: "${OS_PROJECT_NAME:-}"
      OS_USERNAME: "${OS_USERNAME:-}"
      OS_PASSWORD: "${OS_PASSWORD:-}"
      OS_USER_DOMAIN_NAME: "${OS_USER_DOMAIN_NAME:-}"
      OS_PROJECT_DOMAIN_NAME: "${OS_PROJECT_DOMAIN_NAME:-}"
      AWS_ACCESS_KEY_ID: "${AWS_ACCESS_KEY_ID:-}"
      AWS_SECRET_ACCESS_KEY: "${AWS_SECRET_ACCESS_KEY:-}"
    volumes:
      - ${BACKUP_LOCAL_DIR:-/Users/javo/backups/mody.cloud}:/backups
      - ./app/web/uploads:/sources/uploads:ro
      - ./.env:/sources/server/.env:ro
      - ./compose.prod.yml:/sources/server/compose.prod.yml:ro
      - npm_data:/sources/npm/data:ro
      - npm_letsencrypt:/sources/npm/letsencrypt:ro
    networks:
      - default
      # Uptime Kuma's push monitor (BACKUP_PING_URL) is on the proxy's network.
      - proxy
    labels:
      ofelia.enabled: "true"
      ofelia.job-exec.mody-backup-db.schedule: "${OFELIA_BACKUP_DB_SCHEDULE:-0 0 0,6,12,18 * * *}"
      ofelia.job-exec.mody-backup-db.command: "mody-backup db"
      ofelia.job-exec.mody-backup-db.no-overlap: "true"
      ofelia.job-exec.mody-backup-full.schedule: "${OFELIA_BACKUP_FULL_SCHEDULE:-0 30 2 * * *}"
      ofelia.job-exec.mody-backup-full.command: "mody-backup full"
      ofelia.job-exec.mody-backup-full.no-overlap: "true"
      ofelia.job-exec.mody-backup-prune.schedule: "${OFELIA_BACKUP_PRUNE_SCHEDULE:-0 30 4 * * 0}"
      ofelia.job-exec.mody-backup-prune.command: "mody-backup prune"
      ofelia.job-exec.mody-backup-prune.no-overlap: "true"

  mailpit:
    # Never start Mailpit in production. No profile named never-start is ever
    # enabled, so `docker compose up` skips this service.
    profiles: ["never-start"]

# Nginx Proxy Manager's data and its network, from the proxy's own project on
# this host (the backup service reads the volumes and reaches Uptime Kuma).
volumes:
  npm_data:
    external: true
    name: ${NPM_DATA_VOLUME:-proxy_data}
  npm_letsencrypt:
    external: true
    name: ${NPM_LETSENCRYPT_VOLUME:-proxy_letsencrypt}

networks:
  proxy:
    external: true
    name: ${PROXY_NETWORK:-proxy_default}
