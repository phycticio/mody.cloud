#!/bin/bash

ROOT_DIR=$(pwd)
ENV_FILE="${ROOT_DIR}/.env"
./bin/log "INFO" "Checking .env file exists in ${ENV_FILE}"
if [ ! -f "${ENV_FILE}" ]; then
  ./bin/log "ERROR" "No .env file found"
  exit 1;
fi
source "${ENV_FILE}";


declare -A STAGE_SITES=(
    ["stagehub.tamarindintelligence.com"]="hub.tamarindintelligence.local|1"
    ["stageapp.ecigintelligence.com"]="app.ecigintelligence.local|2"
    ["stageapp.tobaccointelligence.com"]="app.tobaccointelligence.local|3"
)
