#!/bin/bash

ROOT_DIR=$(pwd)
ENV_FILE="${ROOT_DIR}/.env"
./bin/log "INFO" "Checking .env file exists in ${ENV_FILE}"
if [ ! -f "${ENV_FILE}" ]; then
  ./bin/log "ERROR" "No .env file found"
  exit 1;
fi
source "${ENV_FILE}";


# Remote domain -> "local domain|blog_id", used by the bin/migrate-* scripts.
declare -A STAGE_SITES=(
    ["mody.cloud"]="mody.local|1"
)
