#!/bin/bash

ROOT_DIR=$(pwd)
ENV_FILE="${ROOT_DIR}/.env"
./bin/log "INFO" "Checking .env file exists in ${ENV_FILE}"
if [ ! -f "${ENV_FILE}" ]; then
  ./bin/log "ERROR" "No .env file found"
  exit 1;
fi
source "${ENV_FILE}";

THEME="theme"
PLUGINS=(
  "advanced-custom-fields-pro"
  "gravityforms"
  "omitsis-location-detector"
  "omitsis-tableau"
  "query-monitor"
  "redirection"
  "tamarind-analytics"
  "tamarind-base"
  "tamarind-favourites"
  "tamarind-forms"
  "tamarind-hidden-toc"
  "tamarind-mapsvg"
  "tamarind-notifications"
  "tamarind-original-creation-date"
  "tamarind-pdfs"
  "tamarind-reports"
  "tamarind-rest-api"
  "tamarind-search"
  "tamarind-subscriptions"
  "tamarind-table-of-contents"
  "tamarind-templates-custom-lists"
  "tamarind-user-area"
  "tamarind-wp-cli"
  "ultimate-addons-for-gutenberg"
)
