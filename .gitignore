.DS_Store
.idea
.env
.env.*

# Core dumps: a crashed process in the app container writes "core" (or
# "core.<pid>") into its working directory, the web root, and the file holds
# the container's whole environment (database passwords, API keys). Ignored here
# so a careless "git add -A" cannot commit one; bin/deploy never ships them
# either, and Nginx never serves them.
app/core
app/core.*

**/*/old-theme
acf-json-old/

app/auth.json
app/dumps/*
app/logs/*
app/vendor/*
app/web/.htaccess
app/web/advanced-cache.php
app/web/cache
app/web/license.txt
app/web/omitsis-logs
app/web/plugins/*
# Spectra, installed by Composer as a MU plugin (M3-11).
app/web/mu-plugins/spectra-blocks/
# Antispam Bee, installed by Composer as a MU plugin (tickets/antibot-altcha.md).
app/web/mu-plugins/antispam-bee/
app/web/readme.html
app/web/themes
app/web/uploads/*
app/web/w3tc-config
app/wweb/wflogs
app/web/*.md

app/web/ewww/
app/web/wflogs/
app/wp/*

app/web/wflogs
app/web/ewww

backups

!app/wp/.gitkeep
!app/web/plugins/omitsis*
!app/web/plugins/tamarind*
!app/web/themes/
!app/web/themes/theme
!app/web/themes/theme/styles/
!app/web/themes/theme/styles/**/
!app/web/themes/theme/styles/**/*.json

app/web/plugins/omitsis*/**/vendor/
app/web/plugins/omitsis*/**/dist/
app/web/plugins/tamarind*/**/vendor/
app/web/plugins/tamarind*/**/dist/
app/web/plugins/tamarind*/.phpunit.result.cache

config/ssl/*

node_modules
dist
package-lock.json

# Server-owned compose overrides, copied from the tracked .sample files on each
# server. bin/deploy never ships them.
/compose.prod.yml
/compose.stage.yml
